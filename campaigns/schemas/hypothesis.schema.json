{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "mechanism": {"type": "string", "minLength": 20},
    "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "comparison": {"type": "string"},
          "metric": {"type": "string"},
          "direction": {"type": "string", "enum": ["increase", "decrease", "unchanged"]},
          "minimum_effect": {"type": "number"}
        },
        "required": ["comparison", "metric", "direction", "minimum_effect"],
        "additionalProperties": false
      }
    },
    "falsifier": {"type": "string", "minLength": 10},
    "closest_known_work": {"type": "array", "items": {"type": "string"}},
    "first_probe": {"type": "string", "minLength": 10},
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["title", "mechanism", "scope", "predictions", "falsifier", "closest_known_work", "first_probe", "uncertainties"],
  "additionalProperties": false
}
