{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["complete", "candidate_error"]},
    "protocol": {"type": "string"},
    "task_id": {"type": "string"},
    "suite_id": {"type": "string"},
    "objective_protocol": {"type": "string"},
    "budget_usage": {"type": "object"},
